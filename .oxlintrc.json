{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "warn",
    "typescript/no-explicit-any": "off",
    "typescript/no-this-alias": "off",
    "unicorn/no-useless-spread": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-tools/**",
    "node_modules/**",
    "docs/**",
    "src/libs/**"
  ]
}
