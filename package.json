{
  "name": "cor3-helper",
  "version": "1.8.0",
  "private": true,
  "description": "COR3 Helper Chrome Extension (Salta fork)",
  "cor3Fork": {
    "label": "salta",
    "build": 1
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "sync-versions": "node scripts/sync-versions.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "npm": "^12.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
