{
  "manifest_version": 3,
  "name": "COR3 Helper 2.0",
  "version": "2.0.5",
  "description": "COR3 Helper 2.0 (Salta fork).",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://cor3.gg/*",
    "https://os.cor3.gg/*",
    "https://svc-corie.cor3.gg/*",
    "https://raw.githubusercontent.com/SaltApocalypse/cor3-helper/*",
    "https://cdn.jsdelivr.net/gh/SaltApocalypse/*",
    "https://github.com/SaltApocalypse/cor3-helper/*",
    "https://api.github.com/repos/SaltApocalypse/cor3-helper/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "COR3 Helper 2.0"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon/favicon16.png",
    "48": "icon/favicon48.png",
    "128": "icon/favicon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cor3.gg/*",
        "https://os.cor3.gg/*"
      ],
      "js": [
        "notepack.min.js",
        "msgpack-codec.js",
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://cor3.gg/*",
        "https://os.cor3.gg/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "devtools_page": "devtools.html"
}
